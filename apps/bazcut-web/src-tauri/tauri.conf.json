{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BazCut",
  "version": "2.0.0-dev.1",
  "identifier": "app.bazaara.bazcut",
  "build": {
    "beforeDevCommand": "npm run studio",
    "devUrl": "http://localhost:3018",
    "beforeBuildCommand": "npm run bundle",
    "frontendDist": "../dist-native"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BazCut Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "backgroundColor": "#090c14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/media/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Local-first creative video studio",
    "longDescription": "BazCut by Bazaara. Development build with local editing and device-checked media export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": { "minSdkVersion": 31 },
    "iOS": { "minimumSystemVersion": "17.0", "infoPlist": "Info.plist" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
