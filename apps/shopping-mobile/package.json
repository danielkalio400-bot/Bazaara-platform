{
  "name": "@bazaara/shopping-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "build:android:internal": "npx eas-cli@latest build --platform android --profile internal",
    "build:android:development": "npx eas-cli@latest build --platform android --profile development",
    "build:android:production": "npx eas-cli@latest build --platform android --profile production",
    "build:ios:development": "npx eas-cli@latest build --platform ios --profile development",
    "build:ios:production": "npx eas-cli@latest build --platform ios --profile production"
  },
  "dependencies": {
    "@bazaara/api-client": "0.1.0",
    "@bazaara/bazid-client": "0.1.0",
    "@bazaara/mobile-ui": "0.1.0",
    "expo": "~57.0.22",
    "expo-auth-session": "~57.0.12",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
