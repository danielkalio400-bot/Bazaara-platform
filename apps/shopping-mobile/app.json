{
  "expo": {
    "name": "Shopping",
    "slug": "bazaara-shopping",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bazaara-shopping",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.bazaara.shopping",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.bazaara.shopping",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "buildNumber": "1"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86e35302-5232-4496-8636-9952fbbd74fa"
      }
    }
  }
}
