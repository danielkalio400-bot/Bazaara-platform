# Server-only URL to existing Platform API. Do not use NEXT_PUBLIC for credentials.
PLATFORM_API_ORIGIN=http://127.0.0.1:4000
# All BazID applications in local dev must use localhost (not 127.0.0.1) for their shared host-only cookie.
WORKSPACE_PUBLIC_ORIGIN=http://localhost:3021
NEXT_PUBLIC_SEARCH_ORIGIN=http://localhost:3020
NEXT_PUBLIC_BAZID_ORIGIN=http://localhost:3004
NEXT_PUBLIC_PLATFORM_HOME_ORIGIN=http://localhost:3005
# If root .env has a nondefault BAZID_COOKIE_NAME, set the same cookie name here.
WORKSPACE_SESSION_COOKIE_NAME=bazid_session
