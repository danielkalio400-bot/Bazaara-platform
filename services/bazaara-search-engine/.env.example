# Core
BAZAARA_SEARCH_HOST=127.0.0.1
BAZAARA_SEARCH_PORT=4020
BAZAARA_SEARCH_DATA=./data
BAZAARA_SEARCH_ADMIN_KEY=change-me-before-exposing-the-service
BAZAARA_SEARCH_CORS=http://localhost:3020,http://127.0.0.1:3020

# BazBot
BAZBOT_USER_AGENT=BazBot/1.0 (+https://bazaara.local/search/bazbot)
BAZBOT_AUTO_CRAWL=0
BAZBOT_BATCH_SIZE=10
BAZBOT_INTERVAL_MS=30000
BAZBOT_REQUEST_TIMEOUT_MS=15000
BAZBOT_MAX_HTML_BYTES=5000000
BAZBOT_DEFAULT_CRAWL_DELAY_MS=1500
BAZBOT_MAX_DEPTH=4
BAZBOT_RECRAWL_DAYS=7
BAZBOT_MAX_URLS_PER_SEED=1000
BAZBOT_RENDER_JS=0
BAZBOT_IGNORE_ROBOTS=0
BAZBOT_ALLOW_PRIVATE_NETWORK=0

# Search
BAZAARA_SEARCH_PAGE_SIZE=10
BAZAARA_SEARCH_MAX_PAGE_SIZE=50
BAZAARA_SEARCH_SEMANTIC=1

# Local semantic embeddings. If Ollama is unavailable, BAZAARA falls back to
# deterministic local feature-hash vectors; no external API is required.
BAZAARA_OLLAMA_URL=http://127.0.0.1:11434
BAZAARA_OLLAMA_MODEL=nomic-embed-text
BAZAARA_OLLAMA_ENABLED=0

