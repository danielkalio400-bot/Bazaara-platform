  requestFingerprint String?
  createdAt          DateTime   @default(now())
  promotion          Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  user               User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([promotionId, createdAt])
  @@index([userId, createdAt])
  @@index([requestFingerprint, createdAt])
}

model ReviewMedia {
  id              String          @id @default(cuid())
  productReviewId String?
  sellerReviewId  String?
  type            ReviewMediaType @default(IMAGE)
  url             String
  alt             String?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  productReview   ProductReview?  @relation("ProductReviewMedia", fields: [productReviewId], references: [id], onDelete: Cascade)
  sellerReview    SellerReview?   @relation("SellerReviewMedia", fields: [sellerReviewId], references: [id], onDelete: Cascade)

  @@index([productReviewId, sortOrder])
  @@index([sellerReviewId, sortOrder])
}

model ReviewReport {
  id              String             @id @default(cuid())
  reporterUserId  String
  productReviewId String?
  sellerReviewId  String?
  reason          String
  details         String?
  status          ReviewReportStatus @default(OPEN)
  createdAt       DateTime           @default(now())
  reviewedAt      DateTime?
  reporter        User               @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  productReview   ProductReview?     @relation("ProductReviewReports", fields: [productReviewId], references: [id], onDelete: Cascade)
  sellerReview    SellerReview?      @relation("SellerReviewReports", fields: [sellerReviewId], references: [id], onDelete: Cascade)

  @@unique([reporterUserId, productReviewId])
  @@unique([reporterUserId, sellerReviewId])
  @@index([status, createdAt])
}

model ReviewMerchantResponse {
  id              String         @id @default(cuid())
  productReviewId String?        @unique
  sellerReviewId  String?        @unique
  merchantId      String
  actorUserId     String
  body            String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  productReview   ProductReview? @relation("ProductReviewResponse", fields: [productReviewId], references: [id], onDelete: Cascade)
  sellerReview    SellerReview?  @relation("SellerReviewResponse", fields: [sellerReviewId], references: [id], onDelete: Cascade)
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  actor           User           @relation("ReviewResponseActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([merchantId, createdAt])
}

model SearchQueryEvent {
  id              String   @id @default(cuid())
  userId          String?
  originalQuery   String
  normalizedQuery String
  recoveredQuery  String?
  resultCount     Int
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([normalizedQuery, createdAt])
  @@index([userId, createdAt])
}

model InventoryAdjustment {
  id              String         @id @default(cuid())
  storeId         String
  variantId       String
  inventoryItemId String
  actorUserId     String
  quantityBefore  Int
  quantityAfter   Int
  delta           Int
  reason          String
  note            String?
  createdAt       DateTime       @default(now())
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  actor           User           @relation("InventoryAdjustmentActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@index([variantId, createdAt])
  @@index([actorUserId, createdAt])
}

model GroceryList {
  id            String                    @id @default(cuid())
  userId        String
  name          String
  archived      Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         GroceryListItem[]
  collaborators GroceryListCollaborator[]

  @@index([userId, archived, updatedAt])
}

model GroceryListItem {
  id              String          @id @default(cuid())
  listId          String
  productId       String?
  variantId       String?
  label           String
  normalizedLabel String
  quantity        Int             @default(1)
  checked         Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  list            GroceryList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([listId, normalizedLabel])
  @@index([productId])
  @@index([variantId])
}

model GroceryCustomerPreference {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  dietaryTags                String[] @default([])
  freshnessNotes             String?
  contactPreference          String   @default("CHAT")
  leaveAtDoor                Boolean  @default(false)
  maxReplacementPricePercent Int      @default(10)
  substitutionPolicy         String   @default("BEST_MATCH")
  preferredFulfillment       String   @default("STANDARD")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GroceryCartItemPreference {
  id                      String          @id @default(cuid())
  cartItemId              String          @unique
  substitutionPolicy      String          @default("BEST_MATCH")
  replacementVariantId    String?
  pickerNote              String?
  maxPriceIncreasePercent Int?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  cartItem                CartItem        @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  replacementVariant      ProductVariant? @relation("GroceryReplacementVariant", fields: [replacementVariantId], references: [id], onDelete: SetNull)

  @@index([replacementVariantId])
}

model GroceryListCollaborator {
  id        String      @id @default(cuid())
  listId    String
  userId    String
  role      String      @default("VIEWER")
  createdAt DateTime    @default(now())
  list      GroceryList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId, createdAt])
}

model GroceryStoreConfig {
  id                         String   @id @default(cuid())
  storeId                    String   @unique
  pickupEnabled              Boolean  @default(true)
  expressEnabled             Boolean  @default(false)
  scheduledEnabled           Boolean  @default(true)
  pickerChatEnabled          Boolean  @default(true)
  weightedItemsEnabled       Boolean  @default(true)
  minimumOrderMinor          BigInt   @default(0)
  maxActiveOrders            Int      @default(40)
  prepMinutes                Int      @default(20)
  freeDeliveryThresholdMinor BigInt?
  membershipDiscountBps      Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  store                      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model GroceryDeliverySlot {
  id        String   @id @default(cuid())
  storeId   String
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int
  reserved  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, startsAt, endsAt])
  @@index([storeId, active, startsAt])
}

model GroceryRecurringBasket {
  id        String                       @id @default(cuid())
  userId    String
  name      String
  cadence   String
  nextRunAt DateTime?
  active    Boolean                      @default(true)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     GroceryRecurringBasketItem[]

  @@index([userId, active, nextRunAt])
}

model GroceryRecurringBasketItem {
  id        String                 @id @default(cuid())
  basketId  String
  productId String
  variantId String
  quantity  Int                    @default(1)
  basket    GroceryRecurringBasket @relation(fields: [basketId], references: [id], onDelete: Cascade)
  product   Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([basketId, variantId])
  @@index([productId])
}

model GroceryMembership {
  id                String    @id @default(cuid())
  userId            String    @unique
  tier              String    @default("STANDARD")
  points            Int       @default(0)
  freeDeliveryUntil DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GroceryGroupCart {
  id                 String                   @id @default(cuid())
  cartId             String                   @unique
  hostUserId         String
  shareToken         String                   @unique
  status             String                   @default("OPEN")
  spendingLimitMinor BigInt?
  expiresAt          DateTime
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  cart               Cart                     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  host               User                     @relation("GroceryGroupHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  members            GroceryGroupCartMember[]

  @@index([hostUserId, status, expiresAt])
}

model GroceryGroupCartMember {
  id                     String           @id @default(cuid())
  groupCartId            String
  userId                 String?
  displayName            String
  role                   String           @default("MEMBER")
  status                 String           @default("ACTIVE")
  paymentAllocationMinor BigInt?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  groupCart              GroceryGroupCart @relation(fields: [groupCartId], references: [id], onDelete: Cascade)
  user                   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([groupCartId, userId])
  @@index([groupCartId, status])
}

model GroceryPickerSession {
  id            String                     @id @default(cuid())
  sellerOrderId String                     @unique
  pickerUserId  String?
  status        String                     @default("QUEUED")
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  sellerOrder   ShoppingSellerOrder        @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  picker        User?                      @relation("GroceryPicker", fields: [pickerUserId], references: [id], onDelete: SetNull)
  outcomes      GroceryPickerItemOutcome[]
  messages      GroceryPickerMessage[]

  @@index([pickerUserId, status])
}

model GroceryPickerItemOutcome {
  id                   String               @id @default(cuid())
  sessionId            String
  orderItemId          String               @unique
  status               String               @default("PENDING")
  requestedQuantity    Int
  fulfilledQuantity    Int                  @default(0)
  actualWeightGrams    Int?
  finalUnitPriceMinor  BigInt?
  replacementVariantId String?
  replacementQuantity  Int?
  customerDecision     String               @default("PENDING")
  note                 String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  session              GroceryPickerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderItem            ShoppingOrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  replacementVariant   ProductVariant?      @relation("GroceryReplacementOutcome", fields: [replacementVariantId], references: [id], onDelete: SetNull)

  @@index([sessionId, status])
  @@index([replacementVariantId])
}

model GroceryPickerMessage {
  id           String               @id @default(cuid())
  sessionId    String
  senderUserId String?
  kind         String               @default("TEXT")
  text         String?
  mediaKey     String?
  createdAt    DateTime             @default(now())
  session      GroceryPickerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender       User?                @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
}

model GroceryIssue {
  id                   String               @id @default(cuid())
  orderId              String
  sellerOrderId        String?
  userId               String
  merchantId           String?
  type                 String
  status               String               @default("OPEN")
  details              String?
  requestedAmountMinor BigInt?
  approvedAmountMinor  BigInt?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  order                ShoppingOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder          ShoppingSellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant             Merchant?            @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([merchantId, status, createdAt])
}

model GroceryOrderPreferenceSnapshot {
  id          String        @id @default(cuid())
  orderId     String        @unique
  preferences Json
  createdAt   DateTime      @default(now())
  order       ShoppingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum FoodCartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum FoodFulfillmentType {
  DELIVERY
  PICKUP
}

enum FoodOrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

model FoodRestaurant {
  id                   String                   @id @default(cuid())
  merchantId           String                   @unique
  slug                 String                   @unique
  description          String
  heroImageUrl         String?
  logoImageUrl         String?
  cuisineTags          String[]                 @default([])
  priceBand            Int                      @default(2)
  status               String                   @default("ACTIVE")
  timezone             String                   @default("Africa/Lagos")
  deliveryEnabled      Boolean                  @default(true)
  pickupEnabled        Boolean                  @default(true)
  asapEnabled          Boolean                  @default(true)
  scheduledEnabled     Boolean                  @default(true)
  deliveryFeeMinor     BigInt                   @default(0)
  serviceFeeMinor      BigInt                   @default(0)
  minOrderMinor        BigInt                   @default(0)
  estimatedDeliveryMin Int                      @default(25)
  estimatedDeliveryMax Int                      @default(45)
  rating               Float                    @default(4.6)
  ratingCount          Int                      @default(0)
  latitude             Decimal?                 @db.Decimal(10, 7)
  longitude            Decimal?                 @db.Decimal(10, 7)
  acceptingOrders      Boolean                  @default(true)
  maxActiveOrders      Int                      @default(30)
  prepTimeBufferMin    Int                      @default(0)
  preorderEnabled      Boolean                  @default(true)
  pauseUntil           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  merchant             Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  openingHours         FoodOpeningHour[]
  menuSections         FoodMenuSection[]
  menuItems            FoodMenuItem[]
  carts                FoodCart[]
  orders               FoodOrder[]
  favorites            FoodRestaurantFavorite[]
  promotions           FoodPromotion[]
  groupOrders          FoodGroupOrder[]
  reviews              FoodReview[]
  supportCases         SupportCase[]
  contacts             RestaurantContact[]
  contactAttempts      SupportContactAttempt[]

  @@index([status, acceptingOrders, rating])
}

model FoodOpeningHour {
  id           String         @id @default(cuid())
  restaurantId String
  dayOfWeek    Int
  openMinute   Int
  closeMinute  Int
  closed       Boolean        @default(false)
  restaurant   FoodRestaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId, dayOfWeek])
}

model FoodMenuSection {
  id           String         @id @default(cuid())
  restaurantId String
  slug         String
  title        String
  description  String?
  sortOrder    Int            @default(0)
  active       Boolean        @default(true)
  restaurant   FoodRestaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        FoodMenuItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, active, sortOrder])
}

model FoodMenuItem {
  id                  String                       @id @default(cuid())
  restaurantId        String
  sectionId           String
  slug                String
  name                String
  description         String
  imageUrl            String?
  currency            String                       @default("NGN")
  priceMinor          BigInt
  active              Boolean                      @default(true)
  soldOut             Boolean                      @default(false)
  featured            Boolean                      @default(false)
  dietaryTags         String[]                     @default([])
  prepMinutes         Int?
  sortOrder           Int                          @default(0)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  restaurant          FoodRestaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  section             FoodMenuSection              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  modifierGroups      FoodModifierGroup[]
  cartItems           FoodCartItem[]
  orderItems          FoodOrderItem[]
  favorites           FoodMenuItemFavorite[]
  availabilityWindows FoodMenuAvailabilityWindow[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, active, featured])
  @@index([sectionId, active, sortOrder])
}

model FoodModifierGroup {
  id        String               @id @default(cuid())
  itemId    String
  name      String
  required  Boolean              @default(false)
  minSelect Int                  @default(0)
  maxSelect Int                  @default(1)
  sortOrder Int                  @default(0)
  item      FoodMenuItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options   FoodModifierOption[]

  @@index([itemId, sortOrder])
}

model FoodModifierOption {
  id              String            @id @default(cuid())
  groupId         String
  name            String
  priceDeltaMinor BigInt            @default(0)
  active          Boolean           @default(true)
  sortOrder       Int               @default(0)
  group           FoodModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, active, sortOrder])
}

model FoodCart {
  id              String              @id @default(cuid())
  restaurantId    String
  userId          String?
  guestTokenHash  String?
  status          FoodCartStatus      @default(ACTIVE)
  fulfillmentType FoodFulfillmentType @default(DELIVERY)
  scheduledFor    DateTime?
  cutleryRequired Boolean             @default(false)
  contactless     Boolean             @default(false)
  deliveryAddress Json?
  note            String?
  tipMinor        BigInt              @default(0)
  promoCode       String?
  discountMinor   BigInt              @default(0)
  isGift          Boolean             @default(false)
  recipientName   String?
  recipientPhone  String?
  giftMessage     String?
  groupOrderId    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  restaurant      FoodRestaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user            User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           FoodCartItem[]
  groupOrder      FoodGroupOrder?     @relation(fields: [groupOrderId], references: [id], onDelete: SetNull)

  @@index([restaurantId, userId, status, updatedAt])
  @@index([groupOrderId, status])
  @@index([restaurantId, guestTokenHash, status, updatedAt])
  @@index([guestTokenHash, status, updatedAt])
}

model FoodCartItem {
  id                  String       @id @default(cuid())
  cartId              String
  menuItemId          String
  configurationKey    String
  quantity            Int
  selectedModifiers   Json?
  specialInstructions String?
  unitPriceMinor      BigInt
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  cart                FoodCart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem            FoodMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([cartId, menuItemId, configurationKey])
  @@index([menuItemId])
}

model FoodOrder {
  id                    String                   @id @default(cuid())
  orderNumber           String                   @unique
  userId                String
  restaurantId          String
  status                FoodOrderStatus          @default(PLACED)
  fulfillmentType       FoodFulfillmentType
  scheduledFor          DateTime?
  cutleryRequired       Boolean                  @default(false)
  contactless           Boolean                  @default(false)
  deliveryAddress       Json?
  note                  String?
  currency              String                   @default("NGN")
  subtotalMinor         BigInt
  deliveryFeeMinor      BigInt                   @default(0)
  serviceFeeMinor       BigInt                   @default(0)
  tipMinor              BigInt                   @default(0)
  discountMinor         BigInt                   @default(0)
  promoCode             String?
  totalMinor            BigInt
  paymentMethod         String                   @default("BAZAARA_PAY")
  paymentStatus         String                   @default("PENDING")
  isGift                Boolean                  @default(false)
  recipientName         String?
  recipientPhone        String?
  giftMessage           String?
  groupOrderId          String?
  deliveryPinHash       String?
  deliveryPinVerifiedAt DateTime?
  courierUserId         String?
  courierAssignedAt     DateTime?
  pickedUpAt            DateTime?
  placedAt              DateTime                 @default(now())
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurant            FoodRestaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items                 FoodOrderItem[]
  groupOrder            FoodGroupOrder?          @relation(fields: [groupOrderId], references: [id], onDelete: SetNull)
  trackingEvents        FoodOrderTrackingEvent[]
  messages              FoodOrderMessage[]
  review                FoodReview?
  supportIssues         FoodSupportIssue[]
  supportCases          SupportCase[]
  economics             FoodOrderEconomics?

  @@index([userId, createdAt])
  @@index([groupOrderId, createdAt])
  @@index([restaurantId, status, createdAt])
}

model FoodOrderItem {
  id                  String       @id @default(cuid())
  orderId             String
  menuItemId          String
  itemName            String
  quantity            Int
  unitPriceMinor      BigInt
  lineTotalMinor      BigInt
  selectedModifiers   Json?
  specialInstructions String?
  createdAt           DateTime     @default(now())
  order               FoodOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem            FoodMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
}

model FoodRestaurantFavorite {
  id           String         @id @default(cuid())
  userId       String
  restaurantId String
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   FoodRestaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId, createdAt])
}

model FoodMenuItemFavorite {
  id         String       @id @default(cuid())
  userId     String
  menuItemId String
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem   FoodMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@index([menuItemId, createdAt])
}

model FoodPromotion {
  id                 String         @id @default(cuid())
  restaurantId       String
  code               String?
  title              String
  description        String?
  discountType       String         @default("PERCENT")
  value              Int
  minSubtotalMinor   BigInt         @default(0)
  maxDiscountMinor   BigInt?
  fundingSource      String         @default("MERCHANT")
  merchantFundingBps Int            @default(10000)
  startsAt           DateTime
  endsAt             DateTime
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  restaurant         FoodRestaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
  @@index([restaurantId, active, startsAt, endsAt])
}

model FoodMenuAvailabilityWindow {
  id             String       @id @default(cuid())
  menuItemId     String
  dayOfWeek      Int
  startMinute    Int
  endMinute      Int
  kind           String       @default("REGULAR")
  minLeadMinutes Int          @default(0)
  maxAdvanceDays Int          @default(7)
  active         Boolean      @default(true)
  menuItem       FoodMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, active, dayOfWeek])
}

model FoodGroupOrder {
  id                 String                 @id @default(cuid())
  restaurantId       String
  hostUserId         String
  shareToken         String                 @unique
  status             String                 @default("OPEN")
  spendingLimitMinor BigInt?
  expiresAt          DateTime
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  restaurant         FoodRestaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  host               User                   @relation("FoodGroupHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  members            FoodGroupOrderMember[]
  carts              FoodCart[]
  orders             FoodOrder[]

  @@index([hostUserId, status, expiresAt])
