model ShoppingReturnItem {
  id                    String            @id @default(cuid())
  returnId              String
  orderItemId           String
  quantity              Int
  inspectedQuantity     Int?
  inspectionOutcome     String?
  conditionNotes        String?
  refundableAmountMinor BigInt?
