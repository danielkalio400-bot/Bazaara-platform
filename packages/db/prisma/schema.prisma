model ShoppingOrder {
  id                         String                          @id @default(cuid())
  orderNumber                String                          @unique
  userId                     String
  checkoutId                 String                          @unique
  paymentId                  String?                         @unique
  vertical                   String                          @default("SHOPPING")
  pickupStoreId              String?
  groceryDeliverySlotId      String?
  status                     ShoppingOrderStatus             @default(PLACED)
  paymentStatus              ShoppingPaymentStatus           @default(PENDING)
  currency                   String
  subtotalMinor              BigInt
  serviceFeeBps              Int                             @default(0)
  serviceFeeMinor            BigInt                          @default(0)
  shippingMinor              BigInt                          @default(0)
  deliveryPlatformShareMinor BigInt                          @default(0)
  deliveryGoShareMinor       BigInt                          @default(0)
  taxMinor                   BigInt                          @default(0)
  discountMinor              BigInt                          @default(0)
  promotionId                String?
  promotionCode              String?
  totalMinor                 BigInt
  shippingAddress            Json
  paymentMethod              String
  deliveryMode               String                          @default("STANDARD")
  scheduledFor               DateTime?
  placedAt                   DateTime                        @default(now())
  cancelledAt                DateTime?
  deliveredAt                DateTime?
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  user                       User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  checkout                   ShoppingCheckout                @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
