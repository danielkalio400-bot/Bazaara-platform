  PLATFORM
  CATEGORY
  PRODUCT
  SELLER
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

model Promotion {
  id                   String                 @id @default(cuid())
  code                 String                 @unique
  name                 String
  description          String?
  type                 PromotionType
  scope                PromotionScope         @default(PLATFORM)
  status               PromotionStatus        @default(DRAFT)
  activation           PromotionActivation    @default(CODE)
  priority             Int                    @default(100)
  percentOff           Int?
  amountOffMinor       BigInt?
  maxDiscountMinor     BigInt?
  minimumSubtotalMinor BigInt                 @default(0)
  budgetMinor          BigInt?
  usageLimit           Int?
  perUserLimit         Int                    @default(1)
  firstOrderOnly       Boolean                @default(false)
  customerSegments     String[]               @default([])
  eligibleCountries    String[]               @default([])
  eligibleRegions      String[]               @default([])
  excludedProductIds   String[]               @default([])
  excludedCategoryIds  String[]               @default([])
  excludedMerchantIds  String[]               @default([])
  allowStacking        Boolean                @default(false)
  stackGroup           String?
  fraudRules           Json?
  categoryId           String?
  productId            String?
  merchantId           String?
  startsAt             DateTime
  endsAt               DateTime
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  category             Category?              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product              Product?               @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant             Merchant?              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  checkouts            ShoppingCheckout[]     @relation("CheckoutPromotion")
  orders               ShoppingOrder[]        @relation("OrderPromotion")
  applications         PromotionApplication[]
  attempts             PromotionAttempt[]

  @@index([status, startsAt, endsAt])
  @@index([categoryId, status])
  @@index([productId, status])
  @@index([merchantId, status])
  @@index([activation, status, priority])
}

