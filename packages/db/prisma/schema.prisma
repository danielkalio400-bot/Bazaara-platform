generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  SUSPENDED
  DELETED
}

enum VerificationLevel {
  GUEST
  CONTACT_VERIFIED
  IDENTITY_VERIFIED
  FINANCIAL_VERIFIED
  BUSINESS_VERIFIED
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum OrganizationType {
  SELLER
  RESTAURANT
  GROCERY_MERCHANT
  PHARMACY
  LOGISTICS_FLEET
  BUSINESS_CUSTOMER
  PLATFORM
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  DEAD_LETTER
}

model User {
  id                       String                     @id @default(cuid())
  status                   UserStatus                 @default(ACTIVE)
  verificationLevel        VerificationLevel          @default(GUEST)
  displayName              String?
  locale                   String                     @default("en-NG")
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  deletedAt                DateTime?
  emails                   UserEmail[]
  phones                   UserPhone[]
  passwordCredential       PasswordCredential?
  sessions                 Session[]
  loginAttempts            LoginAttempt[]
  addresses                Address[]
  roleAssignments          UserRole[]
  organizationMembers      OrganizationMember[]
  wallets                  Wallet[]
  notificationPrefs        NotificationPreference[]
  auditActions             AuditLog[]                 @relation("AuditActor")
  wishlist                 Wishlist?
  carts                    Cart[]
  shoppingCheckouts        ShoppingCheckout[]
  shoppingOrders           ShoppingOrder[]
  nativeAuthorizationCodes NativeAuthorizationCode[]
  nativeSessions           NativeSession[]
  productReviews           ProductReview[]
  sellerReviews            SellerReview[]
  promotionApplications    PromotionApplication[]
  promotionAttempts        PromotionAttempt[]
  reviewReports            ReviewReport[]
  reviewResponses          ReviewMerchantResponse[]   @relation("ReviewResponseActor")
  searchQueryEvents        SearchQueryEvent[]
  inventoryAdjustments     InventoryAdjustment[]      @relation("InventoryAdjustmentActor")
  pushDeviceTokens         PushDeviceToken[]
  notifications            Notification[]
  supportCases             SupportCase[]              @relation("SupportRequester")
  assignedSupportCases     SupportCase[]              @relation("SupportAssignee")
  supportMessages          SupportMessage[]           @relation("SupportMessageAuthor")
  supportContactAttempts   SupportContactAttempt[]    @relation("SupportContactAttemptActor")
  supportCustomerContacts  SupportCustomerContactAttempt[] @relation("SupportCustomerContactSubject")
  supportCustomerActions   SupportCustomerContactAttempt[] @relation("SupportCustomerContactActor")
  riskSignals              RiskSignal[]               @relation("RiskSubjectUser")
  riskResolutions          RiskSignal[]               @relation("RiskResolver")
  groceryLists             GroceryList[]
  sharedGroceryLists       GroceryListCollaborator[]
  groceryPreference        GroceryCustomerPreference?
  groceryRecurringBaskets  GroceryRecurringBasket[]
  groceryMembership        GroceryMembership?
  hostedGroceryGroupCarts  GroceryGroupCart[]         @relation("GroceryGroupHost")
  groceryGroupMemberships  GroceryGroupCartMember[]
  groceryPickerSessions    GroceryPickerSession[]     @relation("GroceryPicker")
  groceryPickerMessages    GroceryPickerMessage[]
  groceryIssues            GroceryIssue[]
  foodCarts                FoodCart[]
  foodOrders               FoodOrder[]
  foodRestaurantFavorites  FoodRestaurantFavorite[]
  foodItemFavorites        FoodMenuItemFavorite[]
  hostedFoodGroupOrders    FoodGroupOrder[]           @relation("FoodGroupHost")
  foodGroupMemberships     FoodGroupOrderMember[]
  foodOrderMessages        FoodOrderMessage[]
  foodReviews              FoodReview[]
  foodSupportIssues        FoodSupportIssue[]
  socialProfile            SocialProfile?
  socialBlocksMade         SocialBlock[]               @relation("SocialBlocker")
  socialBlocksReceived     SocialBlock[]               @relation("SocialBlocked")
  socialFollowsMade        SocialFollow[]              @relation("SocialFollower")
  socialFollowsReceived    SocialFollow[]              @relation("SocialFollowed")
  socialReports            SocialReport[]
  chatMemberships          ChatParticipant[]
  chatMessages             ChatMessage[]
  circlePosts              CirclePost[]
  circleLikes              CircleLike[]
  circleComments           CircleComment[]
  forumTopics              ForumTopic[]
  forumThreads             ForumThread[]
  forumReplies             ForumReply[]
  forumThreadVotes         ForumThreadVote[]
  clipPosts                ClipPost[]
  clipLikes                ClipLike[]
  clipComments             ClipComment[]
  tuneTracks               TuneTrack[]
  tuneFavorites            TuneFavorite[]
  tunePlaylists            TunePlaylist[]
  cutProjects              CutProject[]
  sentTransfers            SendTransfer[]             @relation("SendTransferSender")
  receivedTransfers        SendTransfer[]             @relation("SendTransferRecipient")

  @@index([status, createdAt])
}

model UserEmail {
  id         String    @id @default(cuid())
  userId     String
  email      String    @unique
  normalized String    @unique
  verifiedAt DateTime?
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPrimary])
}

model UserPhone {
  id         String    @id @default(cuid())
  userId     String
  e164       String    @unique
  verifiedAt DateTime?
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPrimary])
}

model PasswordCredential {
  userId            String    @id
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id              String        @id @default(cuid())
  userId          String
  tokenHash       String        @unique
  status          SessionStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  lastSeenAt      DateTime      @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  authenticatedAt DateTime      @default(now())
  ipAddress       String?
  userAgent       String?
  deviceLabel     String?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([expiresAt])
}

model NativeAuthorizationCode {
  id                  String    @id @default(cuid())
  userId              String
  clientId            String
  codeHash            String    @unique
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  scope               String    @default("openid profile")
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([clientId, expiresAt])
}

model NativeSession {
  id               String        @id @default(cuid())
  userId           String
  clientId         String
  scope            String        @default("openid profile")
  deviceId         String?
  deviceLabel      String?
  userAgent        String?
  accessTokenHash  String        @unique
  refreshTokenHash String        @unique
  status           SessionStatus @default(ACTIVE)
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  lastSeenAt       DateTime      @default(now())
  revokedAt        DateTime?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, refreshExpiresAt])
  @@index([accessExpiresAt])
  @@index([refreshExpiresAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  userId     String?
  identifier String
  success    Boolean
  ipAddress  String?
  userAgent  String?
  reason     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, createdAt])
  @@index([userId, createdAt])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  id             String        @id @default(cuid())
  userId         String
  roleId         String
  organizationId String?
  scopeKey       String        @default("platform")
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeKey])
  @@index([organizationId, userId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Address {
  id                   String        @id @default(cuid())
  userId               String?
  organizationId       String?
  label                String?
  country              String
  region               String?
  city                 String
  district             String?
  street               String?
  building             String?
  unit                 String?
  postcode             String?
  landmark             String?
  deliveryInstructions String?
  latitude             Decimal?      @db.Decimal(10, 7)
  longitude            Decimal?      @db.Decimal(10, 7)
  placeIdentifier      String?
  contactPhone         String?
  isApproximate        Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

model Organization {
  id             String               @id @default(cuid())
  type           OrganizationType
  legalName      String
  displayName    String
  status         String               @default("PENDING")
  country        String
  businessNumber String?              @unique
  bTaxId         String?              @unique
  legalType      String               @default("INDIVIDUAL")
  contactEmail   String?
  contactPhone   String?
  brandUpdatedAt DateTime?
  closedAt       DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  members        OrganizationMember[]
  userRoles      UserRole[]
  addresses      Address[]
  merchants      Merchant[]
  wallets        Wallet[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  status         String       @default("ACTIVE")
  roleKey        String       @default("MEMBER")
  permissions    String[]     @default([])
  branchIds      String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Merchant {
  id                    String                   @id @default(cuid())
  organizationId        String
  slug                  String                   @unique
  vertical              String
  verifiedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stores                Store[]
  products              Product[]
  shoppingSellerOrders  ShoppingSellerOrder[]
  shoppingCheckoutItems ShoppingCheckoutItem[]
  promotions            Promotion[]
  sellerReviews         SellerReview[]
  reviewResponses       ReviewMerchantResponse[]
  shoppingReturns       ShoppingReturn[]
  riskSignals           RiskSignal[]
  foodRestaurant        FoodRestaurant?
  groceryIssues         GroceryIssue[]

  @@index([organizationId, vertical])
}

model Store {
  id                   String                @id @default(cuid())
  merchantId           String
  name                 String
  status               String                @default("ACTIVE")
  timezone             String                @default("Africa/Lagos")
  fulfillmentModes     String[]              @default(["STANDARD"])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  merchant             Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  inventoryItems       InventoryItem[]
  shoppingSellerOrders ShoppingSellerOrder[]
  inventoryAdjustments InventoryAdjustment[]
  groceryConfig        GroceryStoreConfig?
  groceryDeliverySlots GroceryDeliverySlot[]

  @@index([merchantId, status])
}

model Wallet {
  id             String          @id @default(cuid())
  userId         String?
  organizationId String?
  ownerKey       String
  currency       String
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerAccounts LedgerAccount[]

  @@unique([ownerKey, currency])
  @@index([userId, currency])
  @@index([organizationId, currency])
}

model LedgerAccount {
  id        String        @id @default(cuid())
  walletId  String?
  code      String        @unique
  currency  String
  kind      String
  createdAt DateTime      @default(now())
  wallet    Wallet?       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  entries   LedgerEntry[]

  @@index([walletId, currency])
}

model LedgerTransaction {
  id           String        @id @default(cuid())
  reference    String        @unique
  kind         String
  currency     String
  description  String?
  createdAt    DateTime      @default(now())
  entries      LedgerEntry[]
  payment      Payment?
  supportCases SupportCase[] @relation("LedgerTransactionSupportCases")

  @@index([createdAt, kind])
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  accountId     String
  direction     LedgerDirection
  amountMinor   BigInt
  createdAt     DateTime          @default(now())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
}

model Payment {
  id                  String             @id @default(cuid())
  internalReference   String             @unique
  provider            String
  providerReference   String?
  status              PaymentStatus      @default(CREATED)
  amountMinor         BigInt
  currency            String
  ledgerTransactionId String?            @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  ledgerTransaction   LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  shoppingOrder       ShoppingOrder?
  orchestrationIntent PaymentIntent?

  @@index([provider, providerReference])
  @@index([status, createdAt])
}

model PaymentIntent {
  id                String                  @id @default(cuid())
  orderId           String                  @unique
  legacyPaymentId   String?                 @unique
  clientReference   String                  @unique
  status            PaymentIntentStatus     @default(REQUIRES_PAYMENT_METHOD)
  paymentMethod     String
  provider          String?
  providerReference String?
  amountMinor       BigInt
  capturedMinor     BigInt                  @default(0)
  refundedMinor     BigInt                  @default(0)
  currency          String
  metadata          Json?
  lastErrorCode     String?
  lastErrorMessage  String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  succeededAt       DateTime?
  cancelledAt       DateTime?
  order             ShoppingOrder           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  legacyPayment     Payment?                @relation(fields: [legacyPaymentId], references: [id], onDelete: SetNull)
  attempts          PaymentAttempt[]
  authorizations    PaymentAuthorization[]
  captures          PaymentCapture[]
  refunds           PaymentRefund[]
  failures          PaymentFailure[]
  reconciliations   PaymentReconciliation[]
  supportCases      SupportCase[]

  @@index([status, createdAt])
  @@index([provider, providerReference])
}

model PaymentAttempt {
  id                String                 @id @default(cuid())
  paymentIntentId   String
  provider          String
  attemptNumber     Int
  idempotencyKey    String
  status            PaymentAttemptStatus   @default(CREATED)
  providerReference String?
  requestPayload    Json?
  responsePayload   Json?
  nextRetryAt       DateTime?
  startedAt         DateTime               @default(now())
  completedAt       DateTime?
  updatedAt         DateTime               @updatedAt
  paymentIntent     PaymentIntent          @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  failures          PaymentFailure[]
  authorizations    PaymentAuthorization[]
  captures          PaymentCapture[]

  @@unique([paymentIntentId, attemptNumber])
  @@unique([paymentIntentId, idempotencyKey])
  @@index([provider, providerReference])
  @@index([status, nextRetryAt])
}

model PaymentAuthorization {
  id                String                     @id @default(cuid())
  paymentIntentId   String
  paymentAttemptId  String?
  providerReference String?
  status            PaymentAuthorizationStatus @default(AUTHORIZED)
  amountMinor       BigInt
  currency          String
  authorizedAt      DateTime                   @default(now())
  expiresAt         DateTime?
  updatedAt         DateTime                   @updatedAt
  paymentIntent     PaymentIntent              @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  paymentAttempt    PaymentAttempt?            @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  captures          PaymentCapture[]

  @@index([paymentIntentId, status, authorizedAt])
  @@index([providerReference])
}

model PaymentCapture {
  id                     String                @id @default(cuid())
  paymentIntentId        String
  paymentAttemptId       String?
  paymentAuthorizationId String?
  providerReference      String?
  status                 PaymentCaptureStatus  @default(PENDING)
  amountMinor            BigInt
  currency               String
  createdAt              DateTime              @default(now())
  processedAt            DateTime?
  paymentIntent          PaymentIntent         @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  paymentAttempt         PaymentAttempt?       @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  authorization          PaymentAuthorization? @relation(fields: [paymentAuthorizationId], references: [id], onDelete: SetNull)

  @@index([paymentIntentId, status, createdAt])
  @@index([providerReference])
}

model PaymentRefund {
  id                String              @id @default(cuid())
  paymentIntentId   String
  shoppingReturnId  String?
  idempotencyKey    String
  provider          String?
  providerReference String?
  status            PaymentRefundStatus @default(PENDING)
  amountMinor       BigInt
  currency          String
  reason            String
  requestedByUserId String
  attemptCount      Int                 @default(0)
  lastError         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  processedAt       DateTime?
  paymentIntent     PaymentIntent       @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  shoppingReturn    ShoppingReturn?     @relation(fields: [shoppingReturnId], references: [id], onDelete: SetNull)

  @@unique([paymentIntentId, idempotencyKey])
  @@index([shoppingReturnId, status])
  @@index([status, createdAt])
  @@index([provider, providerReference])
}

model PaymentFailure {
  id               String          @id @default(cuid())
  paymentIntentId  String
  paymentAttemptId String?
  stage            String
  code             String
  message          String
  retryable        Boolean         @default(false)
  metadata         Json?
  createdAt        DateTime        @default(now())
  paymentIntent    PaymentIntent   @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@index([paymentIntentId, createdAt])
  @@index([code, createdAt])
}

model PaymentWebhookEvent {
  id            String               @id @default(cuid())
  provider      String
  eventId       String
  eventType     String
  status        PaymentWebhookStatus @default(RECEIVED)
  signatureHash String?
  payloadHash   String
  payload       Json
  receivedAt    DateTime             @default(now())
  verifiedAt    DateTime?
  processedAt   DateTime?
  errorMessage  String?

  @@unique([provider, eventId])
  @@index([provider, status, receivedAt])
}

model PaymentReconciliation {
  id                  String         @id @default(cuid())
  paymentIntentId     String?
  provider            String
  providerReference   String?
  reportedStatus      String
  reportedAmountMinor BigInt?
  expectedAmountMinor BigInt?
  differenceMinor     BigInt?
  reportedCurrency    String?
  expectedCurrency    String?
  source              String
  actorUserId         String?
  observedAt          DateTime       @default(now())
  resolvedAt          DateTime?
  resolutionNotes     String?
  paymentIntent       PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@index([paymentIntentId, observedAt])
  @@index([provider, providerReference, observedAt])
  @@index([resolvedAt, observedAt])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  scope        String
  key          String
  actorId      String?
  actorScope   String
  requestHash  String
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([scope, key, actorScope])
  @@index([actorId, createdAt])
  @@index([expiresAt])
}

model OutboxEvent {
  id                  String       @id @default(cuid())
  aggregateType       String
  aggregateId         String
  eventType           String
  payload             Json
  status              OutboxStatus @default(PENDING)
  attempts            Int          @default(0)
  availableAt         DateTime     @default(now())
  processingStartedAt DateTime?
  publishedAt         DateTime?
  lastError           String?
  createdAt           DateTime     @default(now())

  @@index([status, availableAt, createdAt])
  @@index([status, processingStartedAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  requestId    String?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
}

model NotificationPreference {
  id       String              @id @default(cuid())
  userId   String
  category String
  channel  NotificationChannel
  enabled  Boolean             @default(true)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
}

model FeatureFlag {
  key         String   @id
  description String?
  enabled     Boolean  @default(false)
  rules       Json?
  updatedAt   DateTime @updatedAt
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model Category {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  parentId    String?
  sortOrder   Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]  @relation("CategoryTree")
  products    Product[]
  promotions  Promotion[]

  @@index([parentId, sortOrder])
  @@index([active, sortOrder])
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                    String                       @id @default(cuid())
  merchantId            String
  categoryId            String
  brandId               String?
  slug                  String                       @unique
  title                 String
  shortDescription      String?
  description           String
  status                ProductStatus                @default(DRAFT)
  currency              String                       @default("NGN")
  priceMinor            BigInt
  compareAtPriceMinor   BigInt?
  featured              Boolean                      @default(false)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  merchant              Merchant                     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  category              Category                     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                 Brand?                       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants              ProductVariant[]
  media                 ProductMedia[]
  wishlistItems         WishlistItem[]
  shoppingOrderItems    ShoppingOrderItem[]
  shoppingCheckoutItems ShoppingCheckoutItem[]
  promotions            Promotion[]
  productReviews        ProductReview[]
  supportCases          SupportCase[]
  groceryListItems      GroceryListItem[]
  groceryRecurringItems GroceryRecurringBasketItem[]

  @@index([status, featured, createdAt])
  @@index([categoryId, status])
  @@index([merchantId, status])
  @@index([brandId, status])
  @@index([priceMinor])
}

model ProductVariant {
  id                     String                       @id @default(cuid())
  productId              String
  sku                    String                       @unique
  title                  String
  attributes             Json?
  priceMinor             BigInt
  compareAtPriceMinor    BigInt?
