model SupportCase {
  id               String              @id @default(cuid())
  userId           String
  organizationId   String?
  channel          String              @default("CONSUMER")
  region           String              @default("NG")
  currency         String              @default("NGN")
  slaDueAt         DateTime?
  context          Json?
  orderId          String?
  foodOrderId      String?
  foodRestaurantId String?
  productId        String?
  paymentIntentId     String?
  shipmentId          String?
  shoppingReturnId    String?
  driveRideId         String?
  ledgerTransactionId String?
  category            String
  subject          String
  description      String
  status           SupportCaseStatus   @default(OPEN)
  priority         SupportCasePriority @default(NORMAL)
  assignedToUserId String?
  escalationReason String?
  resolvedAt       DateTime?
  closedAt         DateTime?
  lastActivityAt   DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation("SupportRequester", fields: [userId], references: [id], onDelete: Restrict)
  assignedTo       User?               @relation("SupportAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  order            ShoppingOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  foodOrder        FoodOrder?          @relation(fields: [foodOrderId], references: [id], onDelete: SetNull)
  foodRestaurant   FoodRestaurant?     @relation(fields: [foodRestaurantId], references: [id], onDelete: SetNull)
  product          Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  paymentIntent     PaymentIntent?      @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  shipment          Shipment?           @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  shoppingReturn    ShoppingReturn?     @relation(fields: [shoppingReturnId], references: [id], onDelete: SetNull)
  driveRide         DriveRide?          @relation("DriveRideSupportCases", fields: [driveRideId], references: [id], onDelete: SetNull)
  ledgerTransaction LedgerTransaction?  @relation("LedgerTransactionSupportCases", fields: [ledgerTransactionId], references: [id], onDelete: SetNull)
  messages          SupportMessage[]
  contactAttempts  SupportContactAttempt[]
  customerContactAttempts SupportCustomerContactAttempt[]

  @@index([userId, status, lastActivityAt])
  @@index([organizationId, status, lastActivityAt])
  @@index([channel, status, priority])
  @@index([assignedToUserId, status, priority])
  @@index([orderId, createdAt])
  @@index([foodOrderId, createdAt])
  @@index([foodRestaurantId, createdAt])
  @@index([paymentIntentId, createdAt])
  @@index([shipmentId, createdAt])
  @@index([shoppingReturnId, createdAt])
  @@index([driveRideId, createdAt])
  @@index([ledgerTransactionId, createdAt])
}

