  id             String   @id @default(cuid())
  reporterUserId String
  targetType     String   @db.VarChar(30)
  targetId       String
  reason         String   @db.VarChar(60)
  detail         String   @default("") @db.VarChar(500)
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  reporter       User     @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, status])
  @@index([reporterUserId, createdAt])
}

model ChatConversation {
  id           String            @id @default(cuid())
  directKey    String            @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  participants ChatParticipant[]
  messages     ChatMessage[]
}

model ChatParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())
  joinedAt       DateTime @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, joinedAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderUserId   String
  clientNonce    String
  body           String   @db.VarChar(4000)
  assetId        String?
  attachmentName String?  @db.VarChar(240)
  attachmentType String?  @db.VarChar(160)
  attachmentBytes BigInt?
  createdAt      DateTime @default(now())
  deletedAt      DateTime?
  replyToMessageId String?
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  replyTo        ChatMessage? @relation("ChatMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        ChatMessage[] @relation("ChatMessageReply")

  @@unique([senderUserId, clientNonce])
  @@index([conversationId, createdAt, id])
  @@index([replyToMessageId])
}

model CirclePost {
  id        String   @id @default(cuid())
  authorId  String
  body      String   @db.VarChar(2000)
  audience  String   @default("PUBLIC") @db.VarChar(12)
  mediaAssetId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     CircleLike[]
  comments  CircleComment[]

  @@index([authorId, createdAt])
  @@index([audience, createdAt, id])
}

model CircleLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}


model CircleComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String   @db.VarChar(1200)
  createdAt DateTime @default(now())
  post      CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt, id])
  @@index([authorId, createdAt])
}

model ForumTopic {
  id          String  @id @default(cuid())
  slug        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(90)
  description String  @default("") @db.VarChar(300)
  creatorId   String
  createdAt   DateTime @default(now())
  creator     User @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  threads     ForumThread[]
}

model ForumThread {
  id        String @id @default(cuid())
  topicId   String
  authorId  String
  title     String @db.VarChar(150)
  body      String @db.VarChar(10000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   ForumReply[]
  votes     ForumThreadVote[]

  @@index([topicId, createdAt, id])
}

model ForumReply {
  id        String @id @default(cuid())
  threadId  String
  authorId  String
  body      String @db.VarChar(5000)
  createdAt DateTime @default(now())
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt, id])
}


model ForumThreadVote {
  threadId  String
  userId    String
  value     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId, createdAt])
}

model ClipPost {
  id         String   @id @default(cuid())
  creatorId  String
  assetId    String   @unique
  caption    String   @default("") @db.VarChar(2200)
  visibility String   @default("PUBLIC") @db.VarChar(12)
  status     String   @default("PUBLISHED") @db.VarChar(20)
  durationMs Int?
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  creator    User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  likes      ClipLike[]
  comments   ClipComment[]

  @@index([visibility, status, createdAt, id])
  @@index([creatorId, createdAt])
}

model ClipLike {
  clipId    String
  userId    String
  createdAt DateTime @default(now())
  clip      ClipPost @relation(fields: [clipId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clipId, userId])
  @@index([userId, createdAt])
}


model ClipComment {
  id        String   @id @default(cuid())
  clipId    String
  authorId  String
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  clip      ClipPost @relation(fields: [clipId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([clipId, createdAt, id])
  @@index([authorId, createdAt])
}

model TuneTrack {
  id          String   @id @default(cuid())
  creatorId   String
  assetId     String   @unique
  title       String   @db.VarChar(160)
  artistLabel String   @default("") @db.VarChar(120)
  visibility  String   @default("PUBLIC") @db.VarChar(12)
  status      String   @default("PUBLISHED") @db.VarChar(20)
  durationMs  Int?
  playCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  playlistItems TunePlaylistItem[]
  favorites     TuneFavorite[]

  @@index([visibility, status, createdAt, id])
  @@index([creatorId, createdAt])
}


model TuneFavorite {
  trackId   String
  userId    String
  createdAt DateTime @default(now())
  track     TuneTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([trackId, userId])
  @@index([userId, createdAt])
}

model TunePlaylist {
  id          String   @id @default(cuid())
  ownerUserId String
  title       String   @db.VarChar(120)
  description String   @default("") @db.VarChar(300)
  visibility  String   @default("PRIVATE") @db.VarChar(12)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  items       TunePlaylistItem[]

  @@index([ownerUserId, updatedAt])
}

model TunePlaylistItem {
  playlistId String
  trackId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())
  playlist   TunePlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      TuneTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@index([playlistId, position, addedAt])
}

model CutProject {
  id            String   @id @default(cuid())
  ownerUserId   String
  sourceAssetId String?
  title         String   @db.VarChar(160)
  editPlan      Json
  status        String   @default("DRAFT") @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, updatedAt])
}

model SendTransfer {
  id              String   @id @default(cuid())
  senderUserId    String
  recipientUserId String
  assetId         String
  fileName        String   @db.VarChar(240)
  note            String   @default("") @db.VarChar(500)
  contentType     String   @db.VarChar(160)
  byteSize        BigInt
  status          String   @default("PENDING") @db.VarChar(20)
  expiresAt       DateTime
  acceptedAt      DateTime?
  downloadedAt    DateTime?
  downloadCount   Int      @default(0)
  maxDownloads    Int?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  sender          User     @relation("SendTransferSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient       User     @relation("SendTransferRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([senderUserId, createdAt])
  @@index([recipientUserId, status, createdAt])
  @@index([expiresAt, status])
}

