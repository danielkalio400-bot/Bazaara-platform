model ShoppingCheckout {
  id                         String                 @id @default(cuid())
  userId                     String
  cartId                     String
  vertical                   String                 @default("SHOPPING")
  pickupStoreId              String?
  groceryDeliverySlotId      String?
  status                     ShoppingCheckoutStatus @default(ACTIVE)
  currency                   String
  subtotalMinor              BigInt
  serviceFeeBps              Int                    @default(0)
  serviceFeeMinor            BigInt                 @default(0)
  shippingMinor              BigInt                 @default(0)
  deliveryPlatformShareMinor BigInt                 @default(0)
  deliveryGoShareMinor       BigInt                 @default(0)
  taxMinor                   BigInt                 @default(0)
  discountMinor              BigInt                 @default(0)
  promotionId                String?
  promotionCode              String?
  totalMinor                 BigInt
  shippingAddress            Json
  paymentMethod              String                 @default("PAY_ON_DELIVERY")
  deliveryMode               String                 @default("STANDARD")
  scheduledFor               DateTime?
  expiresAt                  DateTime
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  user                       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart                       Cart                   @relation(fields: [cartId], references: [id], onDelete: Restrict)
  promotion                  Promotion?             @relation("CheckoutPromotion", fields: [promotionId], references: [id], onDelete: SetNull)
