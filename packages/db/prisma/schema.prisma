model ShoppingReturn {
  id                   String                   @id @default(cuid())
  orderId              String
  sellerOrderId        String?
  merchantId           String?
  status               ShoppingReturnStatus     @default(REQUESTED)
  reason               String
  details              String?
  eligibilityExpiresAt DateTime?
  reviewedAt           DateTime?
  reviewedByUserId     String?
  reviewNotes          String?
  returnCarrier        String?
  returnService        String?
  returnTrackingId     String?
  receivedAt           DateTime?
  inspectedAt          DateTime?
  requestedRefundMinor BigInt?
  approvedRefundMinor  BigInt?
  requestedAt          DateTime                 @default(now())
  resolvedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  order                ShoppingOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder          ShoppingSellerOrder?     @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
